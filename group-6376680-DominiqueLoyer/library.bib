@article{loyerLeviathanAlgorithmiquePouvoir2025c,
	title = {Le {Léviathan} algorithmique : pouvoir, opacité et responsabilité à l'ère de l'intelligence artificielle},
	issn = {ISBN 978-1-0699904-0-2},
	doi = {10.13140/RG.2.2.28011.20002},
	abstract = {Ce rapport d’examen doctoral analyse la crise de redevabilité (accountability) engendrée par l’opacité  des systèmes d’intelligence artificielle modernes. Il soutient que ces systèmes ne représentent pas une  rupture, mais l’intensification et l’automatisation d’une logique de pouvoir ancienne : la bureaucratie. Ainsi,  le document s’ouvre sur une investigation du concept d’interprétabilité des modèles d’apprentissage  automatique. Alors que les algorithmes de type «boîtes noires» Pasquale (2015) gagnent en complexité et  en influence, leur lisibilité cesse d’être une simple option pour devenir une nécessité impérieuse, notamment  dans des secteurs aussi critiques que la santé ou la justice. En nous appuyant sur les cadres théoriques de  Doran et al. (2017) ainsi que de Burkart et Huber (2021), nous proposons une définition multidimensionnelle  de l’interprétabilité, avant d’en disséquer les enjeux éthiques et pratiques. L’analyse met en lumière les  forces, mais aussi les angles morts, des méthodes techniques dominantes comme LIME et SHAP, révélant  ainsi les tensions et les compromis inévitables entre la fidélité d’un modèle, son intelligibilité pour l’humain  et sa complexité intrinsèque.  Le deuxième axe de notre recherche se concentre sur les systèmes de recommandation, désormais au  cœur de l’écosystème numérique et cela depuis le filtrage collaboratif classique jusqu’aux architectures  d’apprentissage profond de pointe comme celles de YouTube, les réseaux de neurones sur graphes (GNNs)  et les grands modèles de langage (LLMs). Cette trajectoire révèle une transformation conceptuelle de la  personnalisation, passant d’un problème de prédiction statistique à un enjeu de représentation structurelle,  puis de raisonnement sémantique, soulevant des défis d’opacité croissants. En nous appuyant sur les  recherches pionnières de Ko et al. (2022) et Koren et Bell (2011), nous élaborons d’abord une taxonomie  rigoureuse des techniques existantes. Cette classification sert de prélude à une comparaison approfondie de  deux approches paradigmatiques fondamentales : le filtrage basé sur le contenu Pariser (2011) et le filtrage  collaboratif par factorisation de matrices. Koren et al. (2009) L’analyse met en lumière leur complémentarité,  le premier offrant l’explicabilité et une solution au démarrage à froid des items, le second une précision et  une capacité de découverte supérieures, au prix d’une opacité accrue et d’une sensibilité au manque de  données.  Ensuite, nous abordons une question cognitive fondamentale en établissant un parallèle critique entre les  algorithmes de personnalisation et le phénomène bureaucratique. En mobilisant les théories de Max Weber  sur la rationalité et la «cage d’acier» (Weber, 1922; Serpa et Ferreira, 2019) et la critique de David Graeber  sur la «stupidité structurelle» et la violence symbolique (Graeber, 2015), nous soutenons que les algorithmes  ne sont pas une rupture mais une intensification, une privatisation et une automatisation de la logique  bureaucratique. La «cage d’acier» wébérienne se métamorphose en une «boîte noire» algorithmique, dont le  scandale des allocations familiales aux Pays-Bas (Toeslagenaffaire) (Heikkilä, 2022; Amnesty International,  2021) illustre les dangers concrets et posant ainsi, une crise de redevabilité et reconfigurant les dynamiques  de pouvoir et de contrôle social.  Par ailleurs, le rapport aborde l’impératif de l’IA explicable (XAI). Au-delà d’une description des méthodes  post-hoc comme LIME et SHAP, il intègre une critique académique fondamentale de leur instabilité et de  leur manque de fidélité. Basé sur les arguments de Rudin (2019) contre l’explication des «boîtes noires» et  1 la perspective de Judea Pearl sur la nécessité d’une «inférence causale» Pearl (2009), nous mettons en  lumière un paradoxe central : le «déplacement de la confiance» de l’algorithme opaque vers son explication,  tout aussi opaque. Ensuite, nous nuancerons cette analyse par les travaux de Béatrice Hibou sur la  «bureaucratisation néolibérale». Hibou (2012)  Enfin, la quatrième partie propose des cadres d’action pour répandre la responsabilité dans la pratique.  Face aux logiques prédatrices que ces systèmes peuvent engendrer, nous esquissons une méthodologie  d’intervention éthique pour leur modification, ancrée dans les principes de la Déclaration de Montréal  pour une IA responsable (Université de Montréal, 2018). Puis, inspirés par le processus collaboratif du  Biosphere Code (Biosphere, 2015),nous esquissons une méthodologie d’intervention éthique pour modifier  les systèmes prédateurs et les principes d’un code de déontologie pour les concepteurs. Ce code est  conçu comme un artefact culturel visant à cultiver une responsabilité partagée, en réponse aux cadres  réglementaires émergents comme l’AI Act européen et aux nouvelles formes de gouvernance participative.  En conclusion, les positions idéologiques que nous prenons dans ce rapport, soutiennent que les défis  posés par l’IA moderne exigent une gouvernance démocratique pour s’assurer que ce nouveau Léviathan  algorithmique serve le bien-être collectif, au-delà de la seule imputabilité individuelle telle que suggérée  par l’article du Point fournie à titre de référence pour la question portant sur un code déontologique.(Neuer,  2018) ISBN: 978-1-0699904-0-2},
	language = {fr},
