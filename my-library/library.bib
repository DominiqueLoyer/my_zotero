@article{faskowitzEdgesBrainNetworks2021,
	title = {Edges in brain networks: {Contributions} to models of structure and function},
	issn = {2472-1751},
	shorttitle = {Edges in brain networks},
	url = {https://direct.mit.edu/netn/article/doi/10.1162/netn_a_00204/106931/Edges-in-brain-networks-Contributions-to-models-of},
	doi = {10.1162/netn_a_00204},
	abstract = {Network models describe the brain as sets of nodes and edges that represent its distributed organization. So far, most discoveries in network neuroscience have prioritized insights that highlight distinct groupings and specialized functional contributions of network nodes. Importantly, these functional contributions are determined and expressed by the web of their interrelationships, formed by network edges. Here, we underscore the important contributions made by brain network edges for understanding distributed brain organization. Different types of edges represent different types of relationships, including connectivity and similarity among nodes. Adopting a specific definition of edges can fundamentally alter how we analyze and interpret a brain network. Furthermore, edges can associate into collectives and higher order arrangements, describe time series, and form edge communities that provide insights into brain network topology complementary to the traditional nodecentric perspective. Focusing on the edges, and the higher order or dynamic information they can provide, discloses previously underappreciated aspects of structural and functional network organization.},
	language = {en},
	urldate = {2024-10-15},
	journal = {Network Neuroscience},
	author = {Faskowitz, Joshua and Betzel, Richard F. and Sporns, Olaf},
	month = oct,
	year = {2021},
	keywords = {notion},
	pages = {1--28},
	file = {PDF:/Users/bk280625/Zotero/storage/QS2X8MFC/Faskowitz et al. - 2021 - Edges in brain networks Contributions to models of structure and function.pdf:application/pdf},
}

