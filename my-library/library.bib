	file = {PDF:/Users/bk280625/Desktop/Revue litterature toutes/NMT_en-ru_040326/PDFs/Wu et al. - 2016 - Google's Neural Machine Translation System Bridging the Gap between Human and Machine Translation.pdf:application/pdf},
