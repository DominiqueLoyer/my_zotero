@article{loyerEvaluationPartie1,
	title = {Évaluation de la partie 1 {Examen} d’été partie en sciences cognitives},
	abstract = {Ce rapport examine les intersections complexes entre les algorithmes de personnalisation, les théories de la bureaucratie et les impératifs de responsabilité dans le développement technologique. En réponse à des questions spécifiques posées par Dominique Loyer, nous analysons le lien entre les algorithmes de personnalisation et le phénomène bureaucratique tel que conceptualisé par Max Weber et critiqué par David Graeber, en nous appuyant sur les travaux de Serpa and Ferreira (2019) et Graeber (2015). Nous explorons ensuite les étapes potentielles pour modifier les algorithmes de personnalisation jugés prédateurs, en nous basant principalement sur les principes de la Déclaration de Montréal pour une IA responsable Déclaration de Montréal IA Responsable (2018), compte tenu de l’inaccessibilité de la référence Praxis Encommun.io Praxis Encommun.io (Date inconnue). Enfin, inspirés par le Biosphere Code Biosphere Code (2015) et confrontés à l’inaccessibilité de l’article de Laurence Neuer Neuer (2018), nous proposons une structure et des principes pour un code de déontologie destiné aux développeurs d’algorithmes de personnalisation, soulignant la responsabilité humaine, organisationnelle et sociale inhérente à leur travail. Cette analyse met en lumière l’opacité, la concentration de pouvoir et les défis d’imputabilité communs aux systèmes bureaucratiques et algorithmiques, tout en esquissant des pistes pour un développement et un déploiement plus éthiques et responsables des technologies de personnalisation.},
	language = {fr},
	author = {Loyer, Dominique S},
	keywords = {notion},
}

