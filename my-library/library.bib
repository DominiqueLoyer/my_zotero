	keywords = {Computer Science - Artificial Intelligence, notion},
	annote = {Comment: 57 pages},
	file = {PDF:/Users/bk280625/Desktop/Revue litterature toutes/gs_080326/PDFs/Feldstein et al. - 2024 - Mapping the Neuro-Symbolic AI Landscape by Architectures A Handbook on Augmenting Deep Learning Thr.pdf:application/pdf},
}

