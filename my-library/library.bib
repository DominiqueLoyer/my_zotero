	note = {arXiv:2404.11018 [cs]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Machine Learning, Computer Science - Computation and Language, notion},
	file = {PDF:/Users/bk280625/Zotero/storage/ZIUNVABB/Agarwal et al. - 2024 - Many-Shot In-Context Learning.pdf:application/pdf},
