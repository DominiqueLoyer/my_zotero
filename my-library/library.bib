	file = {PDF:/Users/bk280625/Desktop/Revue litterature toutes/gs_080326/PDFs/Wan et al. - 2024 - Towards Cognitive AI Systems a Survey and Prospective on Neuro-Symbolic AI.pdf:application/pdf},
