@misc{s.loyerdominiqueEnjeuxConfidentialiteDonnees2020,
	address = {Université de Sherbrooke},
	type = {Diapositives},
	title = {Les enjeux de la confidentialité des données},
	abstract = {Les enjeux de la confidentialité des données ainsi que les traces numériques que nous laissons… Les brèches de sécurité Scandale de Cambridge Analytica: Firme qui a utilisé à des fins politiques (influence des élections américaines de Trump en novembre 2016) les données personnelles de 87 millions d’usagers de Facebook , dont 622 000 Canadiens Analyse de sentiments L’entreprise britannique a d’abord obtenu en 2014 les données de quelque 270 000 utilisateurs de Facebook pour avoir ensuite accès aux contacts desdits utilisateurs Leur application (This is your digital life) proposait un questionnaire qui permettait de dresser le portrait psychologique des utilisateursInformations sensibles Informations sensibles: Des noms, dates de naissance, numéros d’assurance sociale, adresses, numéros de téléphone, courriels, Mais toutes autres données qui permettent de vous retrouver par croissement de données Ex: On connaît votre prénom, on a une idée de votre âge, on connaît une anecdote de vous (vous avez été dans le Club Optimiste de Sherbrooke, vous êtes né en Italie à Palerme. On peut facilement vous trouver…Les traces que nous laissons La discrimination des algorithmes de personnalisation, la boite noire… Les résultats de vos recherches sur le web ne sont pas les mêmes dépendamment de quel endroit vous faîtes vos recherches De si vous êtes connectés à un compte Google qui vous proposent des résultats en fonction de votre profil Les fichiers témoins (cookies) Facebook Reciblage (Retargeting) Le Patriot Act et les enjeux de l’infonuagique (Cloud) Cette législation (suite aux attentats de 2001) impose aux entreprises de droit américain, ainsi qu’à leurs filiales dans le monde, et aux serveurs hébergés sur le territoire des États-Unis quelle que soit la nationalité des entreprises qui les exploitent, de livrer aux services de sécurité américains les données hébergées, sans autorisation préalable requise et l’aval du tribunal et sans notifier les clients},
	language = {fr},
	author = {{S. Loyer Dominique} and Loyer, Dominique},
	year = {2020},
	keywords = {Dominique Loyer, privacy, conférences, confidentialité, notion},
	file = {Les enjeux de la confidentialité des données:/Users/bk280625/Zotero/storage/TTR6D8JH/Les enjeux de la confidentialité des données .pptx:application/vnd.openxmlformats-officedocument.presentationml.presentation;PDF:/Users/bk280625/Zotero/storage/MIYVYQ59/privacy.pdf:application/pdf},
