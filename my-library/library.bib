	note = {arXiv:2303.07839 [cs]
DOI Fix previous DOI: 10.48550/arXiv.2303.07839},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Software Engineering, notion},
	file = {PDF:/Users/bk280625/Zotero/storage/3SCX4GB8/White et al. - 2023 - ChatGPT Prompt Patterns for Improving Code Quality, Refactoring, Requirements Elicitation, and Softw.pdf:application/pdf},
