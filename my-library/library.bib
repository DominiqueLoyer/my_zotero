@article{loyerTraductionAutomatiqueNeuronale2025a,
	title = {Traduction automatique neuronale du {Russe}-{Anglais}},
	url = {https://rgdoi.net/10.13140/RG.2.2.21668.18563},
	doi = {10.13140/RG.2.2.21668.18563},
	abstract = {Système de traduction automatique neuronal du russe vers l'anglais. Importance croissante de la traduction automatique (contenu multilingue).Révolution de la TAN vs approches précédentes (SMT).Architecture dominante : Transformer (Vaswani et al., 2017).Objectifs du Projet :1 Développer un système TAN pour Anglais -{\textgreater} Russe.2 Utiliser des outils open-source (Hugging Face) et données publiques (opus\_books).3 Affiner un modèle préentraîıné (Helsinki-NLP). 14 ́Evaluer (BLEU, chrF) et comparer `a l’ ́etat de l’art.1. Ce mod`ele est bas ́e sur l’architecture Transformer et impl ́ement ́e `a l’aide duframework MarianMT Passage SMT -{\textgreater} TAN (RNNs (Bahdanau et al., 2015) -{\textgreater}Transformer (Vaswani et al., 2017)).Importance des données parallèles (WMT (Ng et al., 2019),OPUS (Tiedemann, 2012)).Modèles préentraîınés bilingues : MarianMT (Helsinki-NLP) 2(Junczys-Dowmunt et al., 2018) sur OPUS. Base solide pour affinage. Modèles multilingues massifs : NLLB (Costa-Juss`a et al., 2022)domine souvent, scores BLEU EN-RU {\textgreater} 40 sur benchmarksWMT (Ng et al., 2019; Costa-Juss`a et al., 2022).2. Helsinki-NLP/opus-mt-en-ru est un modèle préentraîıné spécifiquement pour la traduction de l’anglais vers le russe},
	language = {fr},
	urldate = {2025-10-05},
	publisher = {Unpublished},
	author = {Loyer, Dominique and Loyer, Dominique S},
	year = {2025},
	note = {abstractTranslation: Neural Machine Translation System from Russian to English. Growing importance of machine translation (multilingual content). Revolution of NMT vs previous approaches (SMT). Dominant architecture: Transformer (Vaswani et al., 2017). Project Objectives: 1 Develop an NMT system for English -{\textgreater} Russian. 2 Use open-source tools (Hugging Face) and public data (opus\_books). 3 Fine-tune a pre-trained model (Helsinki-NLP). 4 Evaluate (BLEU, chrF) and compare to the state-of-the-art. 1. This model is based on the Transformer architecture and implemented using the MarianMT framework. Transition from SMT to NMT (RNNs (Bahdanau et al., 2015) -{\textgreater} Transformer (Vaswani et al., 2017)). Importance of parallel data (WMT (Ng et al., 2019), OPUS (Tiedemann, 2012)). Bilingual pre-trained models: MarianMT (Helsinki-NLP) 2 (Junczys-Dowmunt et al., 2018) on OPUS. Solid foundation for fine-tuning. Massive multilingual models: NLLB (Costa-Jussa et al., 2022) often dominates, with EN-RU BLEU scores {\textgreater} 40 on WMT benchmarks (Ng et al., 2019; Costa-Jussa et al., 2022). 2. Helsinki-NLP/opus-mt-en-ru is a pre-trained model specifically for English to Russian translation.
titleTranslation: Neural Machine Translation of Russian-English},
	keywords = {notion},
}

