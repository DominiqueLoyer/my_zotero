% --- Diapositive avec les blocs supprimés ---
\begin{frame}{Explication des Cas d'Utilisation Clés (1/2)}
  \textbf{UC1 : Soumettre une requête de vérification} \\ % Titre en gras
  \textbf{But :} Permettre à l'Utilisateur de demander une évaluation. \\
  \textbf{Acteurs :} Utilisateur (primaire), Système, Système Externe (secondaires). \\
  \textbf{Déroulement :}
  \begin{enumerate}
    \item Utilisateur saisit/colle info (texte, URL).
    \item Utilisateur soumet.
    \item Système reçoit et déclenche le traitement hybride.
    \item Système présente le rapport (via UC2).
  \end{enumerate}

  \medskip % Ajoute un petit espace vertical

  \textbf{UC2 : Générer un rapport de crédibilité} \\ % Titre en gras
  \textbf{But :} Présenter les résultats de manière claire. \\
  \textbf{Acteurs :} Système (primaire), Utilisateur (secondaire). \\
  \textbf{Déroulement :}
  \begin{enumerate}
    \item Système collecte résultats (score, détails, sources...).
    \item Système formate le rapport (structuré, lisible, explications).
    \item Système présente à l'Utilisateur.
  \end{enumerate}
\end{frame}

% --- Diapositive avec les blocs supprimés ---
\begin{frame}{Explication des Cas d'Utilisation Clés (2/2)}
  % Clés BibTeX mises à jour
  \textbf{UC3 : Récupérer des données externes} \\ % Titre en gras
  \textbf{But :} Collecter informations pertinentes (contexte, vérifications). \\
  \textbf{Acteurs :} Sys.(primaire), Sys.Ext. (API Moteur Recher., LLM, «Faits»...). \\
  \textbf{Déroulement :}
  \begin{enumerate}
    \item Système identifie données nécessaires.
    \item Système envoie requêtes aux API externes \citet{GoogleSearchAPI, GoogleFactCheckAPI}. % Key40,41->GoogleSearchAPI; Key42,43->GoogleFactCheckAPI}
    \item Systèmes Externes retournent données.
    \item Système prétraite et stocke temporairement.
  \end{enumerate}
  \textbf{Points Critiques :} Gestion erreurs API, timeouts, limites de taux. % Key44,45 omis

  \medskip % Ajoute un petit espace vertical

  % --- DÉBUT DE L'EXPLICATION UC8 RÉINSÉRÉE ---
  \textbf{UC8 : Mettre à jour les règles/modèles} \\ % Titre en gras
  \textbf{But :} Permettre à l'Expert d'améliorer/adapter le système. \\
  \textbf{Acteurs :} Expert (primaire), Système (secondaire). \\
  \textbf{Déroulement :}
  \begin{enumerate}
    \item Expert accède à l'interface admin.
    \item Expert modifie/ajoute règles ou MAJ/réentraîne modèles IA.
    \item Expert teste les modifications.
    \item Expert déploie.
  \end{enumerate}
   \textbf{Importance :}pour maintenabilité face aux nouvelles menaces \citet{Nabozny2021, Loth2024, ChenShu2023}. % Key17->Nabozny2021; Key21->Loth2024; Key23->ChenShu2023
  % --- FIN DE L'EXPLICATION UC8 RÉINSÉRÉE ---

\end{frame}

% --- DÉBUT DES DIAPOSITIVES AJOUTÉES ---

% --- Diapo pour UC4 ---
\begin{frame}{Explication du Cas d'Utilisation Interne : UC4}
    \textbf{UC4 : Appliquer les règles} \\ % Titre en gras
    \textbf{But :} Appliquer les règles logiques prédéfinies par l'Expert pour une première évaluation rapide. \\
    \textbf{Acteur(s) Primaire(s) :} Système (via UC\_Hybride). \\
    \textbf{Acteur(s) Secondaire(s) :} (Aucun acteur externe direct). \\
    \textbf{Relation :} Inclus (`<<include>>`) dans UC\_Hybride. \\
    \textbf{Description :}
    \begin{itemize}
        \item Le système exécute les `RegleVerification` configurées sur les `DonneesBrutes` récupérées (issues de UC7).
        \item Produit des `ResultatRegle` (ex: score partiel basé sur la source, détection de langage suspect).
        \item Ces résultats sont utilisés par UC6 pour le calcul du score final.
    \end{itemize}
\end{frame}

% --- Diapo pour UC5 ---
\begin{frame}{Explication du Cas d'Utilisation Interne : UC5}
    \textbf{UC5 : Analyser via IA} \\ % Titre en gras
    \textbf{But :} Exécuter des analyses sémantiques et contextuelles via des modèles IA/NLP. \\
    \textbf{Acteur(s) Primaire(s) :} Système (via UC\_Hybride). \\
    \textbf{Acteur(s) Secondaire(s) :} (Aucun acteur externe direct). \\
    \textbf{Relation :} Inclus (`<<include>>`) dans UC\_Hybride. \\
    \textbf{Description :}
    \begin{itemize}
        \item Le système utilise les `ModeleIA` configurés (sentiment, cohérence, biais, NER...) sur les `DonneesBrutes`.
        \item Produit un `ResultatNLP` contenant les analyses détaillées.
        \item Ces résultats sont utilisés par UC6 pour affiner le score de crédibilité.
    \end{itemize}
\end{frame}

% --- Diapo pour UC6 ---
\begin{frame}{Explication du Cas d'Utilisation Interne : UC6}
    \textbf{UC6 : Calculer le score} \\ % Titre en gras
    \textbf{But :} Combiner les résultats des analyses pour générer un score de crédibilité global et des métriques détaillées. \\
    \textbf{Acteur(s) Primaire(s) :} Système (via UC\_Hybride). \\
    \textbf{Acteur(s) Secondaire(s) :} (Aucun acteur externe direct). \\
    \textbf{Relation :} Inclus (`<<include>>`) dans UC\_Hybride. \\
    \textbf{Description :}
    \begin{itemize}
        \item Le système agrège les `ResultatRegle` (de UC4), le `ResultatNLP` (de UC5) et potentiellement l'analyse des `InfoSource` (issues de UC7).
        \item Applique un algorithme de pondération ou de combinaison (défini par l'Expert via UC8) pour calculer le `scoreCredibilite`.
        \item Prépare les `detailsScore` et autres informations pour le `RapportEvaluation` (généré par UC2).
    \end{itemize}
\end{frame}

% --- Diapo pour UC7 ---
\begin{frame}{Explication du Cas d'Utilisation Interne : UC7}
    % Note: La description de UC7 était sous UC3 dans le rapport .tex
    \textbf{UC7 : Récupérer des données externes} \\ % Titre en gras
    \textbf{But :} Collecter les informations pertinentes depuis les sources externes nécessaires à l'analyse. \\
    \textbf{Acteur(s) Primaire(s) :} Système (via UC\_Hybride). \\
    \textbf{Acteur(s) Secondaire(s) :} Système Externe (API Moteur Recherche, API LLM, API Fact-checking...). \\
    \textbf{Relation :} Inclus (`<<include>>`) dans UC\_Hybride. \\
    \textbf{Description :}
    \begin{itemize}
        \item Le système identifie les données nécessaires (contenu URL, contexte, faits...).
        \item Interroge les API des `SystemeExterne` configurés.
        \item Reçoit et prétraite les `DonneesBrutes` pour les analyses UC4 et UC5.
        \item Gère les erreurs, timeouts et limites des API externes.
    \end{itemize}
\end{frame}

% --- FIN DES DIAPOSITIVES AJOUTÉES ---


