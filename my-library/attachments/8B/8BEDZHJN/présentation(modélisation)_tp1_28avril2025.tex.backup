\begin{frame}{Diagramme d'États/Transitions (Cycle de vie d'une Requête)}
 % Clés BibTeX mises à jour
  \begin{figure}[htbp]
    \centering
    % IMPORTANT: Assurez-vous que le fichier 'etats.png' est dans le même répertoire
    % ou fournissez le chemin correct.
     \begin{adjustbox}{width=\textwidth, center}
        \includegraphics[width=1.18\textwidth,height=0.74\textheight]{tp1_modelisation_beamer/etats.png}
    \end{adjustbox}
    \caption{États possibles d'une `RequeteEvaluation` \citet{Larman2004}.} % Key46 -> Larman2004
    \label{fig:beamer_et}
  \end{figure}
  \tiny \textbf{États :} Soumis $\rightarrow$ EnTraitement $\rightarrow$ Analysé $\rightarrow$ RapportGénéré $\rightarrow$ [AvecFeedback]. État final alternatif : Erreur.
\end{frame}

% --- DÉBUT TABLEAU SYNTHÈSE ÉTATS ---
\begin{frame}{Synthèse du Diagramme d'États/Transitions (`RequeteEvaluation`)}
  \begin{table}[htbp]
    \centering
    \caption{Résumé du Cycle de Vie d'une Requête.}
    \label{tab:beamer_states_summary}
    \scriptsize % Smaller font size
    \begin{tabular}{@{}lp{0.3\linewidth}p{0.4\linewidth}@{}}
      \toprule
      État & Description & Transitions Sortantes Principales (Événement / Action) \\
      \midrule
      `Soumis` & Requête créée, en attente de traitement. & `traiterRequete()` / `lancerRecuperationDonnees()` $\rightarrow$ `EnTraitement` \\
      \addlinespace
      `EnTraitement` & Récupération données, analyses règles/IA en cours. & `analyseTerminee()` / `calculerScore()` $\rightarrow$ `Analysé` \newline `echec...()` / `notifierErreur()` $\rightarrow$ `Erreur` \\
      \addlinespace
      `Analysé` & Analyses terminées, score calculé/en calcul. & `scoreCalcule()` / `genererRapport()` $\rightarrow$ `RapportGénéré` \newline `echecCalculScore()` / `notifierErreur()` $\rightarrow$ `Erreur` \\
      \addlinespace
      `RapportGénéré` & Rapport prêt pour consultation. & `fournirFeedback()` / `enregistrerFeedback()` $\rightarrow$ `AvecFeedback` \\
      \addlinespace
      `AvecFeedback` & Feedback utilisateur reçu. & `finTraitementFeedback()` $\rightarrow$ (Fin) \\
      \addlinespace
      `Erreur` & Échec irrécupérable du traitement. & `archiverErreur()` $\rightarrow$ (Fin) \\
      \bottomrule
    \end{tabular}
  \end{table}
\end{frame}
% --- FIN TABLEAU SYNTHÈSE ÉTATS ---

% --- SECTION 3: Composants et Technologies ---
\section{Composants et Technologies Clés}

\begin{frame}{Table : Indicateurs de Crédibilité et Analyses}
 % Clés BibTeX mises à jour
  \begin{table}[htbp]
    \centering
    \caption{Indicateurs Clés et Techniques d'Analyse Associées.}
    \label{tab:beamer_credibility_indicators}
    \tiny % Très petit pour essayer de tout faire rentrer
    \begin{adjustbox}{width=\textwidth} % Ajuster la largeur
    \begin{tabular}{@{}lp{0.65\linewidth}@{}} % Ajuster la largeur de colonne
      \toprule
      Indicateur de Crédibilité & Techniques d'Analyse Associées \\
      \midrule
      \textbf{Exactitude / Facticité} \citet{Pescuma2025} & - Vérification via API Fact-Checking (ClaimReview) \citet{ClaimReviewSchema, GoogleFactCheckAPI} \newline - NER + Interrogation bases de connaissances / Moteurs recherche \citet{Oshikawa2020} \newline - Analyse présence/qualité citations \citet{Kedzie2018} \\ % Key25,33->Pescuma2025; Key49->ClaimReviewSchema; Key74->GoogleFactCheckAPI; Key24->Oshikawa2020; Key48->Kedzie2018
      \addlinespace
      \textbf{Autorité / Réputation Source} \citet{Pescuma2025} & - Consultation bases réputation (via règles, ex: MediaBias) \citet{W3CCredibility2018} \newline - Analyse historique source (règles: ancienneté domaine...) \newline - NER pour identifier experts/institutions cités \citet{Oshikawa2020} \\ % Key25,33->Pescuma2025; Key32->W3CCredibility2018; Key24->Oshikawa2020
      \addlinespace
      \textbf{Objectivité / Biais} \citet{Pescuma2025} & - Modèles Détection Biais (Politique, Genre...) \citet{Shah2025, Menzner2024, Baly2020} \newline - Analyse Sentiment Contextualisée (ton manipulateur) \citet{Ahmed2024} \newline - Analyse diversité points de vue (via infos externes) \\ % Key25,33->Pescuma2025; Key54->Shah2025; Key62->Menzner2024; Key65->Baly2020; Key16->Ahmed2024
      \addlinespace
      \textbf{Présentation / Qualité} \citet{Pescuma2025} & - Analyse Cohérence (Locale/Globale) \citet{Willems2025, Barzilay2008} \newline - Règles détection langage sensationnaliste \citet{Kedzie2018} \newline - Analyse stylométrique \citet{Ahmed2024} \newline - Détection texte généré par IA \citet{Willems2025, Kedzie2018} \\ % Key33->Pescuma2025; Key57->Willems2025; Key58->Barzilay2008; Key35->Kedzie2018; Key16->Ahmed2024; Key30->Willems2025; Key48->Kedzie2018
      \addlinespace
      \textbf{Actualité} \citet{Pescuma2025} & - Règles cohérence dates \newline - Signalement infos obsolètes \\ % Key33->Pescuma2025
      \addlinespace
      \textbf{Persuasion / Fallacies} \citet{Pescuma2025, Kedzie2018} & - Règles détection patterns (émotion excessive...) \citet{Kedzie2018} \newline - Analyse Sentiment (manipulation émotionnelle) \citet{Ahmed2024} \\ % Key25->Pescuma2025; Key48->Kedzie2018; Key35->Kedzie2018; Key16->Ahmed2024
      \bottomrule
    \end{tabular}
    \end{adjustbox}
  \end{table}
\end{frame}

