% --- SECTION 1: Introduction et Problématique ---
\section{Introduction et Problématique}
\begin{frame}
  \frametitle{Contexte : La Surcharge Informationnelle}
  \begin{itemize}
    \item Augmentation massive de l'information ("infobésité").
    \item Difficulté croissante à distinguer l'information fiable.
    \item Polarisation des opinions alimentée par la désinformation. \citet{Metzger2010}
    \item Nécessité d'outils pour aider à l'évaluation critique.
  \end{itemize}
\end{frame}

\begin{frame}
  \frametitle{Le Problème : Désinformation et "Fake News"}
  \begin{itemize}
    \item Prolifération de désinformation, mésinformation et "fake news". \citet{Oshikawa2020, Zhou2020, Pescuma2025}
    \item Impact négatif sur l'opinion publique, la confiance et la démocratie. \citet{Loth2024, Zhou2020}
    \item Illustration tragique lors de la pandémie de COVID-19. \citet{Loth2024, ChenShu2023, Metzger2010}
  \end{itemize}
\end{frame}

\begin{frame}
  \frametitle{Un Nouveau Défi : L'IA Générative}
  \begin{itemize}
    \item Émergence de l'Intelligence Artificielle Générative (GenAI).\citet{Loth2024, ChenShu2023}
    \item Création facile et rapide de contenus synthétiques réalistes. \citet{Loth2024, Willems2025, Thibault2025}
    \item Exacerbation de la crise informationnelle.
    \item Difficulté de distinction entre contenu authentique et synthétique.
  \end{itemize}
\end{frame}

\begin{frame}
  \frametitle{Le Défi de l'Évaluation de la Crédibilité}
  \begin{itemize}
    \item Manque de transparence sur l'origine et la fiabilité des sources. \citet{Metzger2010, W3CCredibility2018, Pescuma2025, Rieh2010}
    \item Évaluation complexe nécessitant temps et compétences spécifiques.
    \item Nature multidimensionnelle de la crédibilité (fiabilité, expertise, exactitude, objectivité, qualité, actualité). \citet{Pescuma2025, Metzger2010}
  \end{itemize}
\end{frame}

% --- Diapositive "Le Défi de l'Infobésité..." SUPPRIMÉE ---

\begin{frame}{Solution Proposée : Système Hybride d'Évaluation}
  \begin{itemize}
    % Clés BibTeX mises à jour
    \item \textbf{Objectif :} Fournir des outils (métriques, analyse sources, opinions divergentes) pour aider l'utilisateur à développer son esprit critique.
    \item \textbf{Approche Hybride} \citet{Ahmed2024} :
      \begin{itemize}
        \item \textbf{Règles Logiques Prédéfinies :} Encodage de connaissances explicites (réputation source, marqueurs linguistiques) \citet{Kedzie2018, W3CCredibility2018}. % Key35->Kedzie2018; Key36,37->W3CCredibility2018
        \item \textbf{IA / Traitement Langage Naturel (NLP) :} Analyse de nuances (sentiment, cohérence, biais), adaptation \citet{Ahmed2024, Loth2024, ChenShu2023}. % Key16->Ahmed2024; Key22->Loth2024; Key23->ChenShu2023
      \end{itemize}
    \item \textbf{Motivation :} Pallier les limites des systèmes purement algorithmiques face à la complexité et la contextualité \citet{Nabozny2021}. % Key17,18,19,20 -> Nabozny2021
    \item \textbf{Buts Spécifiques :} Lutter contre infobésité, détecter désinformation, évaluer sources, présenter métriques simplement, encourager pensée critique, assurer traçabilité, contribuer à la transparence.
  \end{itemize}
\end{frame}

% --- SECTION 2: Modélisation UML ---
\section{Modélisation UML du Système}

\begin{frame}{Acteurs du Système}
  \begin{table}[htbp]
    \centering
    \caption{Acteurs du Système d'Évaluation de Crédibilité.}
    \label{tab:beamer_acteurs}
    \tiny % Réduire la taille si nécessaire
    \begin{tabular}{@{}lp{0.35\linewidth}p{0.35\linewidth}@{}}
      \toprule
      Acteur & Description & Buts Principaux \\
      \midrule
      Utilisateur & Personne souhaitant vérifier la crédibilité. & Soumettre requête, Consulter rapport, Fournir feedback. \\
      \addlinespace
      Expert & Personne qualifiée (config. système). & Ajuster règles/paramètres, Analyser logs. \\
      \addlinespace
      Système Externe & Source de données tierce (API, DB). & Fournir données brutes, Fournir métadonnées. \\
      \addlinespace
      Système & Le système d'évaluation. & Traiter requêtes, Interroger syst. ext., Appliquer règles/IA, Générer rapports. \\
      \bottomrule
    \end{tabular}
  \end{table}
  \vspace{1em} % Espace après le tableau
  % Clés BibTeX mises à jour
  \footnotesize L'acteur "Expert" est crucial pour la maintenance et l'adaptation continue face à l'évolution des menaces \citet{Nabozny2021, Loth2024, ChenShu2023}. % Key17->Nabozny2021; Key21->Loth2024; Key23->ChenShu2023
\end{frame}

\begin{frame}{Diagramme des Cas d'Utilisation}
  \begin{figure}[htbp]
    \centering
    \includegraphics[width=0.97\textwidth,height=0.83\textheight, keepaspectration]{tp1_modelisation_beamer/UC_VF.png}
