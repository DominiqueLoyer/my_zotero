
@article{benoit_lapprentissage_2018,
	title = {L’apprentissage et la pratique de l’écriture scientifique aux études supérieures},
	volume = {37},
	issn = {1203-9438, 1703-8480},
	url = {https://www.erudit.org/fr/revues/ps/2018-v37-n3-ps04083/1053489ar/resume/},
	doi = {10.7202/1053489ar},
	abstract = {Qui n’a pas déjà entendu l’expression « une bonne thèse est une thèse finie » ? La popularité de cette formule tient probablement au fait qu’elle résume en peu de mots le constat qu’il ne suffit pas d’avoir des réflexions intéressantes pour réussir un mémoire ou une thèse, mais qu’il faut surtout être capable de coucher sur papier ses idées pour mener à terme son projet. Or, nombreux sont les étudiant·e·s qui rencontrent des difficultés au moment d’écrire. Ce court article explore les défis que pose l’apprentissage de la rédaction aux cycles supérieurs et propose des solutions pratiques pour surmonter la procrastination et le syndrome de la page blanche, mais surtout pour encourager les étudiant·e·s à devenir des écrivain·e·s qui réussiront à mettre un point final à leur manuscrit.},
	language = {fr},
	number = {3},
	urldate = {2024-10-15},
	journal = {ps},
	author = {Benoit, Maude},
	year = {2018},
	note = {Publisher: Société québécoise de science politique},
	keywords = {“writer’s block”, cycles supérieurs, graduate level, procrastination, rédaction scientifique, scientific writing, syndrome de la page blanche, thèse, thesis},
	pages = {115--122},
	file = {Full Text:files/5/Benoit - 2018 - L’apprentissage et la pratique de l’écriture scientifique aux études supérieures.pdf:application/pdf;Snapshot:files/6/1053489ar.html:text/html},
