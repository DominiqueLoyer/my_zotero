Python
import pandas as pd import numpy as np from sklearn.metrics.pairwise import cosine_similarity from scipy.sparse import csr_matrix from surprise import Dataset, Reader, SVD


 from surprise.model_selection import train_test_split as surprise_train_test_split from surprise import accuracy
# --- Chargement et Préparation des Données (MovieLens 100k) --# Assurez-vous d'avoir téléchargé le dataset MovieLens 100k (ml-100k) # Chemins vers les fichiers (à adapter si nécessaire) try: # Essayez de lire à partir d'un emplacement commun ou spécifié path_to_ml100k = 'ml-100k/' column_names = ['user_id', 'item_id', 'rating', 'timestamp'] ratings_df = pd.read_csv(path_to_ml100k + 'u.data', sep='\t', names=column_names) except FileNotFoundError: print("Erreur: Le dossier 'ml-100k' n'a pas été trouvé.") print("Veuillez télécharger le dataset MovieLens 100k de https://grouplens.org/datasets/movielens/100k/") print("et le décompresser dans le répertoire courant ou adapter 'path_to_ml100k'.") # Pour permettre au reste du code de s'exécuter sans erreur immédiate, # créons un DataFrame vide. L'exécution échouera plus tard. ratings_df = pd.DataFrame(columns=column_names)
if not ratings_df.empty: n_users = ratings_df['user_id'].nunique() n_items = ratings_df['item_id'].nunique() print(f"Nombre d'utilisateurs: {n_users}, Nombre d'items: {n_items}")
# Création de la matrice utilisateur-item pour User-Based CF user_item_matrix = ratings_df.pivot(index='user_id', columns='item_id', values='rating') user_item_matrix_filled = user_item_matrix.fillna(0) user_item_sparse_matrix = csr_matrix(user_item_matrix_filled.values)
# --- Implémentation User-Based Collaborative Filtering --print("\n--- User-Based Collaborative Filtering ---")
# 1. Calcul de la similarité entre utilisateurs (Cosinus) user_similarity = cosine_similarity(user_item_sparse_matrix) # [29] np.fill_diagonal(user_similarity, 0) user_similarity_df = pd.DataFrame(user_similarity, index=user_item_matrix.index, columns=user_item_matrix.index)
# 2. Fonction de prédiction pour User-Based CF def predict_user_based(user_id, item_id, user_item_mat, user_sim_df, k=25): if user_id not in user_item_mat.index or item_id not in user_item_mat.columns: return 3.0 # Note moyenne par défaut


 sim_scores = user_sim_df[user_id].sort_values(ascending=False) item_ratings = user_item_mat[item_id] valid_neighbors = sim_scores.index.intersection(item_ratings.dropna().index) top_k_neighbors = sim_scores.loc[valid_neighbors].head(k) # [29]
if top_k_neighbors.empty: user_mean = user_item_mat.loc[user_id].mean() return user_mean if not pd.isna(user_mean) else 3.0
weighted_sum = 0 similarity_sum = 0 for neighbor_id, similarity in top_k_neighbors.items(): rating = user_item_mat.loc[neighbor_id, item_id] weighted_sum += similarity * rating # Moyenne pondérée [29] similarity_sum += similarity
if similarity_sum == 0: return 3.0 prediction = weighted_sum / similarity_sum return prediction
# Exemple de prédiction user_example = 1 item_example = 50 # Star Wars (item_id=50 dans ml-100k) pred_ub = predict_user_based(user_example, item_example, user_item_matrix, user_similarity_df, k=30) print(f"Prédiction User-Based pour utilisateur {user_example}, item {item_example}: {pred_ub:.2f}")
# --- Implémentation Matrix Factorization (SVD avec Surprise) --print("\n--- Matrix Factorization (SVD avec Surprise) ---")
# 1. Préparer les données pour Surprise reader = Reader(rating_scale=(1, 5)) data = Dataset.load_from_df(ratings_df[['user_id', 'item_id', 'rating']], reader)
# 2. Séparer en ensembles d'entraînement et de test trainset, testset = surprise_train_test_split(data, test_size=0.2, random_state=42)
# 3. Instancier et entraîner l'algorithme SVD algo_svd = SVD(n_factors=50, n_epochs=20, random_state=42, verbose=False) # [29] print("Entraînement du modèle SVD...") algo_svd.fit(trainset) # Apprend p_u, q_i, b_u, b_i [29]


 print("Entraînement terminé.")
# 4. Faire des prédictions sur l'ensemble de test print("Prédictions sur l'ensemble de test...") predictions_svd = algo_svd.test(testset)
# 5. Évaluer la performance (RMSE) rmse_svd = accuracy.rmse(predictions_svd, verbose=True)
# Exemple de prédiction pour le même utilisateur/item pred_svd_obj = algo_svd.predict(uid=user_example, iid=item_example) # Calcul q_i^T p_u + biais [29] print(f"Prédiction SVD pour utilisateur {user_example}, item {item_example}: {pred_svd_obj.est:.2f}")
else: print("Impossible de continuer sans les données MovieLens 100k.")
● Explication du Code : Charge les données MovieLens. Pour User-Based CF, crée la matrice utilisateur-item, calcule les similarités cosinus 29, puis prédit via une moyenne
pondérée des notes des k voisins.29 Pour MF, utilise la bibliothèque surprise pour
charger les données, entraîner un modèle SVD (factorisation de matrices 29) et évaluer le RMSE. 5.2.5. Limitations des Systèmes de Recommandation Les systèmes de recommandation font face à plusieurs défis inhérents. Le problème de la sparsité (matrice utilisateur-item très creuse) affecte particulièrement le CF basé mémoire.30 Le démarrage à froid rend difficile la recommandation pour les nouveaux utilisateurs ou items.30 La scalabilité peut être un problème pour les approches basées mémoire avec de nombreux utilisateurs/items.29 Le filtrage basé contenu souffre de sur-spécialisation et manque de sérendipité. Même la factorisation de matrices, bien que gérant mieux la sparsité, souffre du démarrage à froid et d'un manque d'interprétabilité.29 Les systèmes hybrides tentent de pallier ces problèmes mais introduisent leur propre complexité.30 D'autres enjeux incluent la prise en compte de la dynamique temporelle des préférences 29, l'intégration efficace du feedback implicite 28, et les questions d'équité, de diversité et de biais dans les recommandations.
5.3. Méthodes d'Ensemble : BMA vs. Bagging 5.3.1. La Raison d'Être de l'Apprentissage par Ensemble
● Idée Fondamentale : Combiner plusieurs modèles ("apprenants de base") pour améliorer performance, robustesse et réduire erreurs.35 ● Décomposition Biais-Variance : L'erreur de généralisation = Biais2 + Variance + Bruit. Les ensembles réduisent souvent la variance (Bagging 3) ou les deux (Boosting 35).


 ● Perspective de Domingos : Leçon n°9 : "Apprenez plusieurs modèles, pas un seul".1 Les ensembles surpassent quasi-systématiquement les modèles uniques.
● Analyse d'Article : Domingos, P. - "A few useful things to know about machine learning" 1
○ Résumé : Distille 12 leçons pratiques clés pour les praticiens du ML (généralisation, overfitting, biais-variance, dimensionnalité, feature engineering, données, ensembles). ○ Positionnement : Synthèse de sagesse pratique largement citée. ○ Résultats Principaux : Importance de la généralisation 2 ; compromis
biais-variance 3 ; malédiction de la dimensionnalité 1 ; importance du feature
engineering 1 ; plus de données > algo plus intelligent 1 ; puissance des
ensembles.1 ○ Limitations : Heuristiques générales, peu de détails techniques/preuves ; certaines nuances potentiellement dépassées par le deep learning. 5.3.2. Agrégation Bayésienne de Modèles (BMA)
● Cadre Théorique : Approche bayésienne pour gérer l'incertitude du modèle.32 Moyenne les prédictions de modèles candidats {Mj}, pondérée par leur probabilité postérieure P(Mj∣Yn).32 $$ P(M_j | Y^n) = \frac{P(Y^n | M_j) P(M_j)}{\sum_{r=1}^{k} P(Y^n | M_r) P(M_r)} \propto P(Y^n | M_j) P(M_j) $$ où P(Mj) est le prior du modèle et P(Yn∣Mj) est la vraisemblance marginale (évidence), intégrant sur les paramètres θj : P(Yn∣Mj)=∫Lj(θj∣Yn)pj(θj)dθj.32 L'évidence pénalise la complexité (Rasoir d'Ockham). Prédiction BMA : P(ynew∣Yn)=∑j=1kP(ynew∣Mj,Yn)P(Mj∣Yn).32 ● Facteurs de Bayes : Bij=P(Yn∣Mi)/P(Yn∣Mj) compare l'évidence de deux modèles.32
● Défis : Spécification des priors (paramètres, modèles) 34 ; Coût computationnel
(intégration, espace des modèles immense) 33 ; Approximations nécessaires : BIC
(logP(Yn∣Mj)≈logLj(θ^j∣Yn)−2djlogn 36), MCMC (MC3).36
● Analyse d'Article : Wasserman, L. - "Bayesian model selection and model averaging" 32
○ Résumé : Revue de l'approche bayésienne (sélection/moyenne), focus sur priors non informatifs, BIC, MCMC. ○ Positionnement : Revue pédagogique des fondements et aspects pratiques. ○ Résultats Principaux : Dérivation probabilité postérieure ; rôle vraisemblance marginale/Facteurs de Bayes ; BIC comme approximation ; discussion priors non informatifs/MCMC.36 ○ Limitations : Revue, pas recherche originale ; détails d'implémentation brefs ; suppose familiarité concepts bayésiens.
● Analyse d'Article : Solomonoff, R. J. - "Algorithmic Probability—Theory and Applications" 65
○ Résumé : Introduit la Probabilité Algorithmique (ALP) : P(x)=∑p:U(p)=x2−l(p),


 basée sur complexité de Kolmogorov. Discute complétude, incalculabilité, applications (prédiction, grammaires).65 ○ Positionnement : Travail fondateur en AIT, base théorique pour Rasoir d'Ockham et induction universelle. Pertinent pour priors BMA basés sur complexité. ○ Résultats Principaux : Définition ALP ; preuve complétude (converge vers vraie probabilité) 65 ; incalculabilité mais approximations possibles 65 ; lien
probabilité/prédiction/compression ; subjectivité liée à machine de référence.65
○ Limitations : Très théorique ; ALP incalculable 65, nécessite approximations (MDL) ;
débats philosophiques 69 ; connexion à BMA pratique surtout conceptuelle. 5.3.3. Bagging (Bootstrap Aggregating)
● Algorithme : Créer m échantillons bootstrap Di (taille n, avec remise) -> Entraîner apprenant de base hi sur chaque Di -> Agréger prédictions (vote majoritaire pour classification, moyenne pour régression).35 ● Fondements Théoriques :
○ Réduction de Variance : Principal mécanisme. Efficace pour apprenants "instables" (ex: arbres non élagués). Moyennage sur échantillons bootstrap lisse les fluctuations.3
○ Interprétation Bayésienne (Domingos 35) : Réfute que Bagging approxime BMA.
Suggère que Bagging modifie l'espace/prior implicite de l'apprenant. En créant un ensemble complexe, il contrecarre un "biais de simplicité" inapproprié de l'apprenant de base, déplaçant la probabilité vers des modèles plus complexes mieux ajustés.35
● Analyse d'Article : Domingos, P. - "Why Does Bagging Work? A Bayesian Account and its Implications" 35
○ Résumé : Teste empiriquement (via Bayes) pourquoi Bagging fonctionne. Réfute hypothèse Bagging ≈ BMA ; soutient hypothèse modification prior/espace modèle. ○ Positionnement : Contribution à la compréhension du mécanisme de Bagging, interprétation bayésienne spécifique. ○ Résultats Principaux : Rejet empirique Bagging ≈ BMA (moyenne pondérée < vote uniforme) 35 ; soutien empirique modif. prior (méta-règle + complexe et + précise)
35 ; conclusion : combat biais de simplicité excessif.35 ○ Limitations : Focus sur C4.5 ; méta-apprentissage indirect ; généralisation à d'autres apprenants/datasets?
5.3.4. Analyse Comparative : BMA vs. Bagging
● Objectif : BMA = Gérer incertitude structurelle modèle 32 ; Bagging = Réduire variance /
Stabiliser apprenant.35
● Base Théorique : BMA = Bayésienne 32 ; Bagging = Fréquentiste (variance) / Bayes
(modif. prior).35 ● Entrée : BMA = Ensemble modèles candidats + Priors ; Bagging = Un algo de base + Données. ● Agrégation : BMA = Pondération par probabilités postérieures (évidence) ; Bagging =


 Pondération uniforme (vote/moyenne). ● Hypothèses : BMA = Vrai modèle (ou approx.) dans l'ensemble + Validité priors ; Bagging = Apprenant de base instable. ● Coût : BMA = Très élevé (intégration, espace modèles) 33 ; Bagging = m x coût base, parallélisable. ● Interprétabilité : BMA = Modérée (via P(Mj∣Yn)) ; Bagging = Faible (ensemble = boîte noire).
