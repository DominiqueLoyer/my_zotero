@article{8d6fd3522bc80cb512c3bb1f93ce52643fb976a1,
  title = {{FP-STALKER: Tracking browser fingerprint evolutions}},
  author = {Vastel, Antoine and Laperdrix, Pierre and Rudametkin, Walter and Rouvoy, Romain},
  year = 2018,
  journal = {2018 IEEE Symposium on Security and Privacy (SP)},
  volume = {null},
  pages = {728--741},
  doi = {10.1109/SP.2018.00008},
  url = {https://www.semanticscholar.org/paper/8d6fd3522bc80cb512c3bb1f93ce52643fb976a1},
  abstract = {Browser fingerprinting has emerged as a technique to track users without their consent. Unlike cookies, fingerprinting is a stateless technique that does not store any information on devices, but instead exploits unique combinations of attributes handed over freely by browsers. The uniqueness of fingerprints allows them to be used for identification. However, browser fingerprints change over time and the effectiveness of tracking users over longer durations has not been properly addressed. In this paper, we show that browser fingerprints tend to change frequently---from every few hours to days---due to, for example, software updates or configuration changes. Yet, despite these frequent changes, we show that browser fingerprints can still be linked, thus enabling long-term tracking. FP-STALKER is an approach to link browser fingerprint evolutions. It compares fingerprints to determine if they originate from the same browser. We created two variants of FP-STALKER, a rule-based variant that is faster, and a hybrid variant that exploits machine learning to boost accuracy. To evaluate FP-STALKER, we conduct an empirical study using 98,598 fingerprints we collected from 1, 905 distinct browser instances. We compare our algorithm with the state of the art and show that, on average, we can track browsers for 54.48 days, and 26},
  langid = {canadien},
  language = {fr-CA},
  keywords = {notion},
  groups = {ConnectedPapers-for-The-Web-Never-Forgets_3A-Pe},
  timestamp = {2026-02-05T00:09:49Z}
}

@article{8def6612f19323144d4bfa06accc05dd0601656b,
  title = {{Cookieless monster: Exploring the ecosystem of web-based device fingerprinting}},
  author = {Nikiforakis, Nick and Kapravelos, A. and Joosen, W. and Kr{\"u}gel, Christopher and Piessens, Frank and Vigna, Giovanni},
  year = 2013,
  journal = {2013 IEEE Symposium on Security and Privacy},
  volume = {null},
  pages = {541--555},
  doi = {10.1109/SP.2013.43},
  url = {https://www.semanticscholar.org/paper/8def6612f19323144d4bfa06accc05dd0601656b},
  abstract = {The web has become an essential part of our society and is currently the main medium of information delivery. Billions of users browse the web on a daily basis, and there are single websites that have reached over one billion user accounts. In this environment, the ability to track users and their online habits can be very lucrative for advertising companies, yet very intrusive for the privacy of users. In this paper, we examine how web-based device fingerprinting currently works on the Internet. By analyzing the code of three popular browser-fingerprinting code providers, we reveal the techniques that allow websites to track users without the need of client-side identifiers. Among these techniques, we show how current commercial fingerprinting approaches use questionable practices, such as the circumvention of HTTP proxies to discover a user's real IP address and the installation of intrusive browser plugins. At the same time, we show how fragile the browser ecosystem is against fingerprinting through the use of novel browser-identifying techniques. With so many different vendors involved in browser development, we demonstrate how one can use diversions in the browsers' implementation to distinguish successfully not only the browser-family, but also specific major and minor versions. Browser extensions that help users spoof the user-agent of their browsers are also evaluated. We show that current commercial approaches can bypass the extensions, and, in addition, take advantage of their shortcomings by using them as additional fingerprinting features.},
  langid = {canadien},
  language = {fr-CA},
  keywords = {notion},
  annotation = {abstractTranslation: The web has become an essential part of our society and is currently the main medium of information delivery. Billions of users browse the web on a daily basis, and there are single websites that have reached over one billion user accounts. In this environment, the ability to track users and their online habits can be very lucrative for advertising companies, yet very intrusive for the privacy of users. In this paper, we examine how web-based device fingerprinting currently works on the Internet. By analyzing the code of three popular browser-fingerprinting code providers, we reveal the techniques that allow websites to track users without the need of client-side identifiers. Among these techniques, we show how current commercial fingerprinting approaches use questionable practices, such as the circumvention of HTTP proxies to discover a user's real IP address and the installation of intrusive browser plugins. At the same time, we show how fragile the browser ecosystem is against fingerprinting through the use of novel browser-identifying techniques. With so many different vendors involved in browser development, we demonstrate how one can use diversions in the browsers' implementation to distinguish successfully not only the browser-family, but also specific major and minor versions. Browser extensions that help users spoof the user-agent of their browsers are also evaluated. We show that current commercial approaches can bypass the extensions, and, in addition, take advantage of their shortcomings by using them as additional fingerprinting features.},
  groups = {ConnectedPapers-for-The-Web-Never-Forgets_3A-Pe},
  timestamp = {2026-01-16T16:35:31Z}
}

@article{9243f5103669bd0e5b29f333f6e1d2246dc0a492,
  title = {{Pixel perfect : Fingerprinting canvas in HTML 5}},
  author = {Mowery, K. and Shacham, H.},
  year = 2012,
  url = {https://www.semanticscholar.org/paper/9243f5103669bd0e5b29f333f6e1d2246dc0a492},
  abstract = {Tying the browser more closely to operating system functionality and system hardware means that websites have more access to these resources, and that browser behavior varies depending on the behavior of these resources. We propose a new system fingerprint, inspired by the observation above: render text and WebGL scenes to a \textexclamdown canvas\textquestiondown{} element, then examine the pixels produced. The new fingerprint is consistent, high-entropy, orthogonal to other fingerprints, transparent to the user, and readily obtainable.},
