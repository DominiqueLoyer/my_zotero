@article{loyerOntologieSysVerification2025,
  title = {{Ontologie - Sys. de V\'erification de la Cr\'edibilit\'e de l'Information Projet Final pr\'esent\'e \`a Petko Valchev, DIC-9335 Sciences du Web}},
  author = {Loyer, Dominique S and Loyer, Dominique},
  year = 2025,
  pages = {22},
  publisher = {Unpublished},
  doi = {10.13140/RG.2.2.25249.72807},
  url = {https://rgdoi.net/10.13140/RG.2.2.25249.72807},
  urldate = {2025-10-05},
  abstract = {Prolif\'eration exponentielle de l'information en ligne (Zhou et Zafarani 2020; Viviani et Pasi 2017). Difficult\'e croissante pour les utilisateurs \`a \'evaluer la fiabilit\'e des sources et des contenus (Metzger, Flanagin et Medders 2010; Rieh 2010). Impact soci\'etal majeur de la d\'esinformation (m\'esinformation, fake news) (Sharma et al. 2019; Souza et al. 2020; Oshikawa, Qian et Wang 2020). Complexit\'e accrue par l'IA g\'en\'erative (GenAI) capable de cr\'eer des contenus synth\'etiques r\'ealistes (K. Chen et Shu 2023; Loth, Kappes et Pahl 2024). Besoin de transparence et d'explicabilit\'e des syst\`emes IA, notamment les LLMs (Liao2024; Mahari2023; Zou2023; Chaudhary2024; DiakopoulosND).},
  langid = {french},
  language = {fr},
  keywords = {notion},
  annotation = {abstractTranslation: Exponential proliferation of online information (Zhou and Zafarani 2020; Viviani and Pasi 2017). Increasing difficulty for users to evaluate the reliability of sources and content (Metzger, Flanagin, and Medders 2010; Rieh 2010). Major societal impact of disinformation (misinformation, fake news) (Sharma et al. 2019; Souza et al. 2020; Oshikawa, Qian, and Wang 2020). Increased complexity due to generative AI (GenAI) capable of creating realistic synthetic content (K. Chen and Shu 2023; Loth, Kappes, and Pahl 2024). Need for transparency and explainability of AI systems, particularly LLMs (Liao2024; Mahari2023; Zou2023; Chaudhary2024; DiakopoulosND).},
  timestamp = {2026-01-16T16:34:46Z}
}

