@article{norahhadialsaeedWishYouWere2017,
  title = {Wish {{You Were Here}}: {{A Psychological Analysis Using Atkinson-Shiffrin Memory Mode}}},
  shorttitle = {Wish {{You Were Here}}},
  author = {{Norah Hadi Alsaeed}},
  year = 2017,
  month = apr,
  journal = {JLAS},
