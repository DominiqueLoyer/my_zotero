@article{loyerDeveloppementEvaluationDun,
  title = {{D\'eveloppement et \'Evaluation d'un Syst\`eme de Traduction Automatique Neuronale Anglais--Russe}},
  author = {Loyer, Dominique S},
  abstract = {Ce rapport pr\'esente le d\'eveloppement et l'\'evaluation d'un syst\`eme de traduction automatique neuronale (TAN) Anglais{$\rightarrow$}Russe (EN{$\rightarrow$}RU). En utilisant la biblioth\`eque Hugging Face Transformers(Wolf et al., 2020) et un mod\`ele pr\'e-entra\^in\'e Helsinki-NLP/opus-mt-en-ru(JunczysDowmunt and Grundkiewicz, 2018) bas\'e sur l'architecture Transformer(Vaswani et al., 2017), nous avons fine-tun\'e le mod\`ele sur un sous-ensemble de 10 000 paires de phrases du corpus parall\`ele opus\_books(Tiedemann, 2012). Le syst\`eme a \'et\'e entra\^in\'e pendant 3 \'epoques dans un environnement Kaggle (GPU T4). L'\'evaluation sur un jeu de test r\'eserv\'e du m\^eme corpus donne SacreBLEU 22.6 et chrF 48.5.},
  langid = {french},
  language = {fr},
  keywords = {No DOI found,notion},
  annotation = {abstractTranslation: This report presents the development and evaluation of an English--Russian neural machine translation (NMT) system (EN{$\rightarrow$}RU). Using the Hugging Face Transformers library (Wolf et al., 2020) and a pre-trained Helsinki-NLP/opus-mt-en-ru model (JunczysDowmunt and Grundkiewicz, 2018) based on the Transformer architecture (Vaswani et al., 2017), we fine-tuned the model on a subset of 10,000 sentence pairs from the opus\_books parallel corpus (Tiedemann, 2012). The system was trained for 3 epochs in a Kaggle environment (T4 GPU). Evaluation on a held-out test set from the same corpus yielded SacreBLEU 22.6 and chrF 48.5.},
  groups = {GS_301225.bibtex,GoogleScholar_mypapers290925,Projet RI et Projet Tan,mes papiers et beamers},
  timestamp = {2026-03-08T21:43:24Z},
  file = {PDF:files/3534/Loyer - Développement et Évaluation d’un Système de Traduction Automatique Neuronale Anglais–Russe.pdf:application/pdf;PDF:files/935/Loyer - Développement et Évaluation d’un Système de Traduction Automatique Neuronale Anglais–Russe.pdf:application/pdf}
}

