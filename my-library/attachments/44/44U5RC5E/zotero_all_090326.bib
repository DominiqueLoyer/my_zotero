@techreport{loyerRAPPORTRECHERCHEPRESENTE2025,
  type = {{Rapport de recherche}},
  title = {{RAPPORT DE RECHERCHE PR\'ESENT\'E COMME EXIGENCE PARTIELLE DU DOCTORAT EN INFORMATIQUE COGNITIVE}},
  shorttitle = {{Rapport de recherche DIC-9401 (Le L\'eviathan algorithmique: pouvoir, opacit\'e et responsabilit\'e \`a l'\`ere de l'intelligence artificielle)}},
  author = {Loyer, Dominique},
  year = 2025,
  pages = {64},
  address = {Montr\'eal},
  institution = {UQAM},
  urldate = {2025-10-17},
  abstract = {Ce rapport d'examen doctoral analyse la crise de redevabilit\'e (accountability) engendr\'ee par l'opacit\'e des syst\`emes d'intelligence artificielle modernes. Il soutient que ces syst\`emes ne repr\'esentent pas une rupture, mais l'intensification et l'automatisation d'une logique de pouvoir ancienne : la bureaucratie. Ainsi, le document s'ouvre sur une investigation du concept d'interpr\'etabilit\'e des mod\`eles d'apprentissage automatique. Alors que les algorithmes de type <<bo\^ites noires>> Pasquale (2015) gagnent en complexit\'e et en influence, leur lisibilit\'e cesse d'\^etre une simple option pour devenir une n\'ecessit\'e imp\'erieuse, notamment dans des secteurs aussi critiques que la sant\'e ou la justice. En nous appuyant sur les cadres th\'eoriques de Doran et al. (2017) ainsi que de Burkart et Huber (2021), nous proposons une d\'efinition multidimensionnelle de l'interpr\'etabilit\'e, avant d'en diss\'equer les enjeux \'ethiques et pratiques. L'analyse met en lumi\`ere les forces, mais aussi les angles morts, des m\'ethodes techniques dominantes comme LIME et SHAP, r\'ev\'elant ainsi les tensions et les compromis in\'evitables entre la fid\'elit\'e d'un mod\`ele, son intelligibilit\'e pour l'humain et sa complexit\'e intrins\`eque. Le deuxi\`eme axe de notre recherche se concentre sur les syst\`emes de recommandation, d\'esormais au c\oe ur de l'\'ecosyst\`eme num\'erique et cela depuis le filtrage collaboratif classique jusqu'aux architectures d'apprentissage profond de pointe comme celles de YouTube, les r\'eseaux de neurones sur graphes (GNNs) et les grands mod\`eles de langage (LLMs). Cette trajectoire r\'ev\`ele une transformation conceptuelle de la personnalisation, passant d'un probl\`eme de pr\'ediction statistique \`a un enjeu de repr\'esentation structurelle, puis de raisonnement s\'emantique, soulevant des d\'efis d'opacit\'e croissants. En nous appuyant sur les recherches pionni\`eres de Ko et al. (2022) et Koren et Bell (2011), nous \'elaborons d'abord une taxonomie rigoureuse des techniques existantes. Cette classification sert de pr\'elude \`a une comparaison approfondie de deux approches paradigmatiques fondamentales : le filtrage bas\'e sur le contenu Pariser (2011) et le filtrage collaboratif par factorisation de matrices. Koren et al. (2009) L'analyse met en lumi\`ere leur compl\'ementarit\'e, le premier offrant l'explicabilit\'e et une solution au d\'emarrage \`a froid des items, le second une pr\'ecision et une capacit\'e de d\'ecouverte sup\'erieures, au prix d'une opacit\'e accrue et d'une sensibilit\'e au manque de donn\'ees. Ensuite, nous abordons une question cognitive fondamentale en \'etablissant un parall\`ele critique entre les algorithmes de personnalisation et le ph\'enom\`ene bureaucratique. En mobilisant les th\'eories de Max Weber sur la rationalit\'e et la <<cage de fer>> (Weber, 1922; Serpa et Ferreira, 2019) et la critique de David Graeber sur la <<stupidit\'e structurelle>> et la violence symbolique (Graeber, 2015), nous soutenons que les algorithmes ne sont pas une rupture mais une intensification, une privatisation et une automatisation de la logique bureaucratique. La <<cage de fer>> w\'eb\'erienne se m\'etamorphose en une <<bo\^ite noire>> algorithmique, dont le scandale des allocations familiales aux Pays-Bas (Toeslagenaffaire) illustre les dangers concrets et posant ainsi, une crise de redevabilit\'e et reconfigurant les dynamiques de pouvoir et de contr\^ole social. Par ailleurs, le rapport aborde l'imp\'eratif de l'IA explicable (XAI). Au-del\`a d'une description des m\'ethodes post-hoc comme LIME et SHAP, il int\`egre une critique acad\'emique fondamentale de leur instabilit\'e et de leur manque de fid\'elit\'e. Bas\'e sur les arguments de Rudin (2019) contre l'explication des 1 <<bo\^ites noires>> et la perspective de Judea Pearl sur la n\'ecessit\'e d'une inf\'erence causale, nous mettons en lumi\`ere un paradoxe central : le <<d\'eplacement de la confiance>> de l'algorithme opaque vers son explication, tout aussi opaque. Ensuite, nous nuancerons cette analyse par les travaux de B\'eatrice Hibou sur la <<bureaucratisation n\'eolib\'erale>>. Enfin, la quatri\`eme partie propose des cadres d'action pour r\'epandre la responsabilit\'e dans la pratique. Face aux logiques pr\'edatrices que ces syst\`emes peuvent engendrer, nous esquissons une m\'ethodologie d'intervention \'ethique pour leur modification, ancr\'ee dans les principes de la D\'eclaration de Montr\'eal pour une IA responsable. Puis, inspir\'es par le processus collaboratif du Biosphere Code (Biosphere, 2015),nous esquissons une m\'ethodologie d'intervention \'ethique pour modifier les syst\`emes pr\'edateurs et les principes d'un code de d\'eontologie pour les concepteurs. Ce code est con\c cu comme un artefact culturel visant \`a cultiver une responsabilit\'e partag\'ee, en r\'eponse aux cadres r\'eglementaires \'emergents comme l'AI Act europ\'een et aux nouvelles formes de gouvernance participative. En conclusion, cette th\`ese soutient que les d\'efis pos\'es par l'IA moderne exigent une gouvernance d\'emocratique pour s'assurer que ce nouveau L\'eviathan algorithmique serve le bien-\^etre collectif, au-del\`a de la seule imputabilit\'e individuelle (Neuer, 2018).},
  langid = {french},
  language = {fr},
  keywords = {Beatrice Hibou,Bureaucraphie algorithmique,Cynthia Rudin,David Graeber,dic-9401,Dominique Loyer,Ethique de l'intelligence artificielle,Explicabilite de l'intelligence artificielle,Filtres collaboratifs,IA Explicable,IA Explicable (XAI) Systemes de Recommandation Apprentissage Profond Bureaucratie Algorith-,l'IA Ethique de l'intelligence artificielle Examen de synthese de doctorat.,Leviathan algorithmique,Max Weber,mique Max Weber David Graeber Beatrice Hibou Cynthia Rudin Informatique Cognitive Gouvernance de,notion,rapport de doctorat,Systemes de recommandation,Transparence algorithmique,Weberisme numerique},
  annotation = {abstractTranslation: This doctoral review report analyzes the crisis of accountability engendered by the opacity of modern artificial intelligence systems. It argues that these systems do not represent a break, but rather the intensification and automation of an old power logic: bureaucracy. Thus, the document opens with an investigation into the concept of interpretability of machine learning models. As "black box" algorithms (Pasquale, 2015) gain complexity and influence, their readability ceases to be a mere option and becomes an imperative necessity, particularly in sectors as critical as healthcare or justice. Drawing on the theoretical frameworks of Doran et al. (2017) and Burkart and Huber (2021), we propose a multidimensional definition of interpretability, before dissecting its ethical and practical implications. The analysis highlights the strengths, but also the blind spots, of dominant technical methods like LIME and SHAP, thus revealing the unavoidable tensions and compromises between model fidelity, human intelligibility, and intrinsic complexity.\\
\\
The second axis of our research focuses on recommendation systems, which are now at the heart of the digital ecosystem, from classic collaborative filtering to cutting-edge deep learning architectures such as those used by YouTube, graph neural networks (GNNs), and large language models (LLMs). This trajectory reveals a conceptual transformation of personalization, shifting from a problem of statistical prediction to an issue of structural representation, and then to semantic reasoning, raising increasing opacity challenges. Drawing on the pioneering research of Ko et al. (2022) and Koren and Bell (2011), we first develop a rigorous taxonomy of existing techniques. This classification serves as a prelude to an in-depth comparison of two fundamental paradigmatic approaches: content-based filtering (Pariser, 2011) and matrix factorization collaborative filtering (Koren et al., 2009). The analysis highlights their complementarity, with the former offering explainability and a solution to item cold-start problems, while the latter provides superior accuracy and discovery capability, at the cost of increased opacity and sensitivity to data sparsity.\\
\\
Next, we address a fundamental cognitive question by drawing a critical parallel between personalization algorithms and the bureaucratic phenomenon. Mobilizing Max Weber's theories on rationality and the "iron cage" (Weber, 1922; Serpa and Ferreira, 2019) and David Graeber's critique of "structural stupidity" and symbolic violence (Graeber, 2015), we argue that algorithms are not a rupture but an intensification, privatization, and automation of bureaucratic logic. The Weberian "iron cage" transforms into an algorithmic "black box," the concrete dangers of which are illustrated by the Dutch family benefits scandal (Toeslagenaffaire), thus posing a crisis of accountability and reconfiguring dynamics of power and social control.\\
\\
Furthermore, the report addresses the imperative of explainable AI (XAI). Beyond a description of post-hoc methods like LIME and SHAP, it integrates a fundamental academic critique of their instability and lack of fidelity. Based on Rudin's (2019) arguments against explaining "black boxes" and Judea Pearl's perspective on the necessity of causal inference, we highlight a central paradox: the "displacement of trust" from the opaque algorithm to its explanation, which is equally opaque. Subsequently, we will nuance this analysis with Beatrice Hibou's work on "neoliberal bureaucratization."\\
\\
Finally, the fourth part proposes action frameworks for spreading responsibility in practice. Faced with the predatory logics that these systems can engender, we outline a methodology for ethical intervention for their modification, anchored in the principles of the Montreal Declaration for Responsible AI. Then, inspired by the collaborative process of the Biosphere Code (Biosphere, 2015), we outline a methodology for ethical intervention to modify predatory systems and the principles of a code of ethics for designers. This code is conceived as a cultural artifact aimed at cultivating shared responsibility, in response to emerging regulatory frameworks such as the European AI Act and},
  groups = {annotations_monRapport_111025},
  timestamp = {2026-01-27T00:39:37Z},
  file = {PDF:files/1714/Loyer - RAPPORT DE RECHERCHE PRÉSENTÉ COMME EXIGENCE PARTIELLE DU DOCTORAT EN INFORMATIQUE COGNITIVE(ancVers).pdf:application/pdf;LOYD20017302_DÉPÔT_DIC9401:files/1754/zoteroRDF.rdf:application/pdf}
}

