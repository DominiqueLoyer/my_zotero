  keywords = {notion},
  annotation = {abstractTranslation: Tying the browser more closely to operating system functionality and system hardware means that websites have more access to these resources, and that browser behavior varies depending on the behavior of these resources. We propose a new system fingerprint, inspired by the observation above: render text and WebGL scenes to a canvas element, then examine the pixels produced. The new fingerprint is consistent, high-entropy, orthogonal to other fingerprints, transparent to the user, and readily obtainable.},
  groups = {ConnectedPapers-for-The-Web-Never-Forgets_3A-Pe},
  timestamp = {2026-01-16T16:35:42Z}
}

@article{96df51029b8f6c936c9909bd45a9b0b8498d1ffa,
  title = {{Detecting and defending against third-party tracking on the web}},
  author = {Roesner, Franziska and Kohno, Tadayoshi and Wetherall, D.},
  year = 2012,
  url = {https://www.semanticscholar.org/paper/96df51029b8f6c936c9909bd45a9b0b8498d1ffa},
  abstract = {While third-party tracking on the web has garnered much attention, its workings remain poorly understood. Our goal is to dissect how mainstream web tracking occurs in the wild. We develop a client-side method for detecting and classifying five kinds of third-party trackers based on how they manipulate browser state. We run our detection system while browsing the web and observe a rich ecosystem, with over 500 unique trackers in our measurements alone. We find that most commercial pages are tracked by multiple parties, trackers vary widely in their coverage with a small number being widely deployed, and many trackers exhibit a combination of tracking behaviors. Based on web search traces taken from AOL data, we estimate that several trackers can each capture more than 20},
  langid = {canadien},
  language = {fr-CA},
  keywords = {notion},
  groups = {ConnectedPapers-for-The-Web-Never-Forgets_3A-Pe},
  timestamp = {2026-02-05T00:09:25Z}
