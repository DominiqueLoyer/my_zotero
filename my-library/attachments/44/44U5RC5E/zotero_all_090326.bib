@article{loyerTraductionAutomatiqueNeuronale2025,
  title = {{Traduction automatique neuronale du Russe-Anglais}},
  author = {Loyer, Dominique and Loyer, Dominique S},
  year = 2025,
  publisher = {Unpublished},
  doi = {10.13140/RG.2.2.21668.18563},
  url = {https://rgdoi.net/10.13140/RG.2.2.21668.18563},
  urldate = {2025-10-05},
  abstract = {Syst\`eme de traduction automatique neuronal du russe vers l'anglais. Importance croissante de la traduction automatique (contenu multilingue).R\'evolution de la TAN vs approches pr\'ec\'edentes (SMT).Architecture dominante : Transformer (Vaswani et al., 2017).Objectifs du Projet :1 D\'evelopper un syst\`eme TAN pour Anglais -{$>$} Russe.2 Utiliser des outils open-source (Hugging Face) et donn\'ees publiques (opus\_books).3 Affiner un mod\`ele pr\'eentra\^i\i n\'e (Helsinki-NLP). 14\' Evaluer (BLEU, chrF) et comparer `a l'\' etat de l'art.1. Ce mod`ele est bas\' e sur l'architecture Transformer et impl\' ement\' e `a l'aide duframework MarianMT Passage SMT -{$>$} TAN (RNNs (Bahdanau et al., 2015) -{$>$}Transformer (Vaswani et al., 2017)).Importance des donn\'ees parall\`eles (WMT (Ng et al., 2019),OPUS (Tiedemann, 2012)).Mod\`eles pr\'eentra\^i\i n\'es bilingues : MarianMT (Helsinki-NLP) 2(Junczys-Dowmunt et al., 2018) sur OPUS. Base solide pour affinage. Mod\`eles multilingues massifs : NLLB (Costa-Juss`a et al., 2022)domine souvent, scores BLEU EN-RU {$>$} 40 sur benchmarksWMT (Ng et al., 2019; Costa-Juss`a et al., 2022).2. Helsinki-NLP/opus-mt-en-ru est un mod\`ele pr\'eentra\^i\i n\'e sp\'ecifiquement pour la traduction de l'anglais vers le russe},
  langid = {french},
  language = {fr},
  keywords = {notion},
  annotation = {abstractTranslation: Neural Machine Translation System from Russian to English. Growing importance of machine translation (multilingual content). Revolution of NMT vs. previous approaches (SMT). Dominant architecture: Transformer (Vaswani et al., 2017). Project Objectives: 1 Develop an NMT system for English -{$>$} Russian. 2 Use open-source tools (Hugging Face) and public data (opus\_books). 3 Fine-tune a pre-trained model (Helsinki-NLP). 4 Evaluate (BLEU, chrF) and compare to the state-of-the-art. 1. This model is based on the Transformer architecture and implemented using the MarianMT framework. SMT -{$>$} NMT passage (RNNs (Bahdanau et al., 2015) -{$>$} Transformer (Vaswani et al., 2017)). Importance of parallel data (WMT (Ng et al., 2019), OPUS (Tiedemann, 2012)). Bilingual pre-trained models: MarianMT (Helsinki-NLP) 2 (Junczys-Dowmunt et al., 2018) on OPUS. Solid base for fine-tuning. Massive multilingual models: NLLB (Costa-Jussa et al., 2022) often dominates, EN-RU BLEU scores {$>$} 40 on WMT benchmarks (Ng et al., 2019; Costa-Jussa et al., 2022). 2. Helsinki-NLP/opus-mt-en-ru is a pre-trained model specifically for English to Russian translation.},
  timestamp = {2026-01-16T16:34:44Z}
}

