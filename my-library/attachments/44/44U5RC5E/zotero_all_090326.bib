@article{loyerLeviathanAlgorithmiquePouvoir2025f,
  title = {{Le L\'eviathan algorithmique : pouvoir, opacit\'e et responsabilit\'e \`a l'\`ere de l'intelligence artificielle}},
  author = {Loyer, Dominique and Loyer, Dominique S.},
  year = 2025,
  month = oct,
  pages = {64},
  issn = {ISBN 978-1-0699904-0-2},
  doi = {10.13140/RG.2.2.28011.20002},
  abstract = {Ce rapport d'examen doctoral analyse la crise de redevabilit\'e (accountability) engendr\'ee par l'opacit\'e  des syst\`emes d'intelligence artificielle modernes. Il soutient que ces syst\`emes ne repr\'esentent pas une  rupture, mais l'intensification et l'automatisation d'une logique de pouvoir ancienne : la bureaucratie. Ainsi,  le document s'ouvre sur une investigation du concept d'interpr\'etabilit\'e des mod\`eles d'apprentissage  automatique. Alors que les algorithmes de type <<bo\^ites noires>> Pasquale (2015) gagnent en complexit\'e et  en influence, leur lisibilit\'e cesse d'\^etre une simple option pour devenir une n\'ecessit\'e imp\'erieuse, notamment  dans des secteurs aussi critiques que la sant\'e ou la justice. En nous appuyant sur les cadres th\'eoriques de  Doran et al. (2017) ainsi que de Burkart et Huber (2021), nous proposons une d\'efinition multidimensionnelle  de l'interpr\'etabilit\'e, avant d'en diss\'equer les enjeux \'ethiques et pratiques. L'analyse met en lumi\`ere les  forces, mais aussi les angles morts, des m\'ethodes techniques dominantes comme LIME et SHAP, r\'ev\'elant  ainsi les tensions et les compromis in\'evitables entre la fid\'elit\'e d'un mod\`ele, son intelligibilit\'e pour l'humain  et sa complexit\'e intrins\`eque.  Le deuxi\`eme axe de notre recherche se concentre sur les syst\`emes de recommandation, d\'esormais au  c\oe ur de l'\'ecosyst\`eme num\'erique et cela depuis le filtrage collaboratif classique jusqu'aux architectures  d'apprentissage profond de pointe comme celles de YouTube, les r\'eseaux de neurones sur graphes (GNNs)  et les grands mod\`eles de langage (LLMs). Cette trajectoire r\'ev\`ele une transformation conceptuelle de la  personnalisation, passant d'un probl\`eme de pr\'ediction statistique \`a un enjeu de repr\'esentation structurelle,  puis de raisonnement s\'emantique, soulevant des d\'efis d'opacit\'e croissants. En nous appuyant sur les  recherches pionni\`eres de Ko et al. (2022) et Koren et Bell (2011), nous \'elaborons d'abord une taxonomie  rigoureuse des techniques existantes. Cette classification sert de pr\'elude \`a une comparaison approfondie de  deux approches paradigmatiques fondamentales : le filtrage bas\'e sur le contenu Pariser (2011) et le filtrage  collaboratif par factorisation de matrices. Koren et al. (2009) L'analyse met en lumi\`ere leur compl\'ementarit\'e,  le premier offrant l'explicabilit\'e et une solution au d\'emarrage \`a froid des items, le second une pr\'ecision et  une capacit\'e de d\'ecouverte sup\'erieures, au prix d'une opacit\'e accrue et d'une sensibilit\'e au manque de  donn\'ees.  Ensuite, nous abordons une question cognitive fondamentale en \'etablissant un parall\`ele critique entre les  algorithmes de personnalisation et le ph\'enom\`ene bureaucratique. En mobilisant les th\'eories de Max Weber  sur la rationalit\'e et la <<cage d'acier>> (Weber, 1922; Serpa et Ferreira, 2019) et la critique de David Graeber  sur la <<stupidit\'e structurelle>> et la violence symbolique (Graeber, 2015), nous soutenons que les algorithmes  ne sont pas une rupture mais une intensification, une privatisation et une automatisation de la logique  bureaucratique. La <<cage d'acier>> w\'eb\'erienne se m\'etamorphose en une <<bo\^ite noire>> algorithmique, dont le  scandale des allocations familiales aux Pays-Bas (Toeslagenaffaire) (Heikkil\"a, 2022; Amnesty International,  2021) illustre les dangers concrets et posant ainsi, une crise de redevabilit\'e et reconfigurant les dynamiques  de pouvoir et de contr\^ole social.  Par ailleurs, le rapport aborde l'imp\'eratif de l'IA explicable (XAI). Au-del\`a d'une description des m\'ethodes  post-hoc comme LIME et SHAP, il int\`egre une critique acad\'emique fondamentale de leur instabilit\'e et de  leur manque de fid\'elit\'e. Bas\'e sur les arguments de Rudin (2019) contre l'explication des <<bo\^ites noires>> et  1 la perspective de Judea Pearl sur la n\'ecessit\'e d'une <<inf\'erence causale>> Pearl (2009), nous mettons en  lumi\`ere un paradoxe central : le <<d\'eplacement de la confiance>> de l'algorithme opaque vers son explication,  tout aussi opaque. Ensuite, nous nuancerons cette analyse par les travaux de B\'eatrice Hibou sur la  <<bureaucratisation n\'eolib\'erale>>. Hibou (2012)  Enfin, la quatri\`eme partie propose des cadres d'action pour r\'epandre la responsabilit\'e dans la pratique.  Face aux logiques pr\'edatrices que ces syst\`emes peuvent engendrer, nous esquissons une m\'ethodologie  d'intervention \'ethique pour leur modification, ancr\'ee dans les principes de la D\'eclaration de Montr\'eal  pour une IA responsable (Universit\'e de Montr\'eal, 2018). Puis, inspir\'es par le processus collaboratif du  Biosphere Code (Biosphere, 2015),nous esquissons une m\'ethodologie d'intervention \'ethique pour modifier  les syst\`emes pr\'edateurs et les principes d'un code de d\'eontologie pour les concepteurs. Ce code est  con\c cu comme un artefact culturel visant \`a cultiver une responsabilit\'e partag\'ee, en r\'eponse aux cadres  r\'eglementaires \'emergents comme l'AI Act europ\'een et aux nouvelles formes de gouvernance participative.  En conclusion, les positions id\'eologiques que nous prenons dans ce rapport, soutiennent que les d\'efis  pos\'es par l'IA moderne exigent une gouvernance d\'emocratique pour s'assurer que ce nouveau L\'eviathan  algorithmique serve le bien-\^etre collectif, au-del\`a de la seule imputabilit\'e individuelle telle que sugg\'er\'ee  par l'article du Point fournie \`a titre de r\'ef\'erence pour la question portant sur un code d\'eontologique.(Neuer,  2018) ISBN: 978-1-0699904-0-2},
  langid = {french},
  language = {fr},
  keywords = {Bureaucraphie algorithmique,Examen doctoral de synthese,Explicabilite de l'intelligence artificielle,neSy,Transparence algorithmique,xAI},
  annotation = {ORCID="0009-0003-9713-7109"\\
\\
\\
Next, we address a fundamental cognitive question by establishing a critical parallel between personalization algorithms and the bureaucratic phenomenon. Mobilizing Max Weber's theories on rationality and the "iron cage" (Weber, 1922; Serpa and Ferreira, 2019) and David Graeber's critique of "structural stupidity" and symbolic violence (Graeber, 2015), we argue that algorithms are not a rupture but an intensification, privatization, and automation of bureaucratic logic. The Weberian "iron cage" metamorphoses into an algorithmic "black box," the scandal of family benefits in the Netherlands (Toeslagenaffaire) (Heikkil\"a, 2022; Amnesty International, 2021) illustrating its concrete dangers, thus posing an accountability crisis and reconfiguring power dynamics and social control.\\
\\
\\
abstractTranslation: This doctoral examination report analyzes the accountability crisis engendered by the opacity of modern artificial intelligence systems. It argues that these systems do not represent a rupture, but rather an intensification and automation of an old power logic: bureaucracy. Thus, the document opens with an investigation into the concept of interpretability of machine learning models. As "black box" algorithms Pasquale (2015) grow in complexity and influence, their readability ceases to be a mere option and becomes an imperative necessity, particularly in critical sectors such as healthcare and justice. Drawing on the theoretical frameworks of Doran et al. (2017) and Burkart and Huber (2021), we propose a multidimensional definition of interpretability, before dissecting its ethical and practical stakes. The analysis highlights the strengths, but also the blind spots, of dominant technical methods such as LIME and SHAP, thus revealing the unavoidable tensions and trade-offs between model fidelity, human intelligibility, and intrinsic complexity.\\
The second axis of our research focuses on recommendation systems, now at the heart of the digital ecosystem, from classic collaborative filtering to cutting-edge deep learning architectures like those of YouTube, graph neural networks (GNNs), and large language models (LLMs). This trajectory reveals a conceptual transformation of personalization, moving from a problem of statistical prediction to an issue of structural representation, and then to semantic reasoning, raising increasing opacity challenges. Drawing on the pioneering research of Ko et al. (2022) and Koren and Bell (2011), we first develop a rigorous taxonomy of existing techniques. This classification serves as a prelude to an in-depth comparison of two fundamental paradigmatic approaches: content-based filtering Pariser (2011) and matrix factorization collaborative filtering Koren et al. (2009). The analysis highlights their complementarity, the former offering explainability and a solution to the cold-start problem for items, the latter superior accuracy and discovery capability, at the cost of increased opacity and sensitivity to data sparsity.\\
Furthermore, the report addresses the imperative of Explainable AI (XAI). Beyond a description of post-hoc methods like LIME and SHAP, it integrates a fundamental academic critique of their instability and lack of fidelity. Based on Rudin's (2019) arguments against explaining "black boxes" and Judea Pearl's perspective on the necessity of "causal inference" Pearl (2009), we highlight a central paradox: the "displacement of trust" from the opaque algorithm to its explanation, which is equally opaque. We will then nuance this analysis with Beatrice Hibou's work on "neoliberal bureaucratization" Hibou (2012).\\
Finally, the fourth part proposes action frameworks for disseminating responsibility in practice. Faced with the predatory logics that these systems can engender, we outline a methodology for ethical intervention for their modification, rooted in the principles of the Montr\'eal Declaration for Responsible AI (Universit\'e de Montr\'eal, 2018). Then, inspired by the collaborative process of the Biosphere Code (Biosphere, 2015), we outline a methodology for ethical intervention to modify predatory systems and the principles of a code of ethics for designers. This code is conceived as a cultural artifact aimed at fostering shared responsibility, in response to emerging regulatory frameworks such as the European AI Act and new forms of participatory governance. In conclusion, the ideological positions we take in this report support the argument that the challenges posed by modern AI require democratic governance to ensure that this new algorithmic Leviathan serves the collective well-being, beyond mere individual accountability as suggested by the article from Le Point provided as a reference for the question regarding a code of ethics. (Neuer, 2018) ISBN: 978-1-0699904-0-2\\
titleTranslation: The Algorithmic Leviathan: Power, Opacity, and Responsibility in the Age of Artificial Intelligence},
  note = {\texttt{\textbf{@misc}\textbraceleft loyer2025leviathan\_synthesis,} ~doi = \textbraceleft 10.13140/RG.2.2.28011.20002\textbraceright, ~isbn = \textbraceleft 978-1-0699904-0-2\textbraceright, ~orcid = \textbraceleft https://orcid.org/0009-0003-9713-7109\textbraceright, ~url = \textbraceleft https://www.researchgate.net/doi/10.13140/RG.2.2.28011.20002\textbraceright, ~author = \textbraceleft Loyer, Dominique S.\textbraceright, ~title = \textbraceleft Le Leviathan Algorithmique: pouvoir, opacite et responsabilite a l'ere de l'intelligence artificielle\textbraceright, ~year = \textbraceleft 2025\textbraceright, ~pages = \textbraceleft 64\textbraceright, ~note = \textbraceleft Doctoral Synthesis Exam DIC-9401\textbraceright\textbraceright{}},
  groups = {dic-9401 icolonne vers finale rapport},
  timestamp = {2026-01-09T20:58:12Z},
  file = {PDF:files/1909/Loyer - RAPPORT DE RECHERCHE PRÉSENTÉ COMME EXIGENCE PARTIELLE DU DOCTORAT EN INFORMATIQUE COGNITIVE.pdf:application/pdf}
