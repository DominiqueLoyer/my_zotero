/**
* Règle pour gérer le cas des lampes défectueuses de la même pièce */
rule Piece {
when { ?x: Lampe(etat == false; ?p: piece); not Lampe(etat == true; piece == ?p); exists Lampe(etat == true; piece != ?p); }
then { assert Conseil("Vérifier l'interrupteur ou le fusible de la pièce"); } };
