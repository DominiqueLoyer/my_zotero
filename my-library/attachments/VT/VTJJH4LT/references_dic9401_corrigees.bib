\section{Formulaire LaTeX consolidé}
\label{sec:appendix}
Cette section fournit une liste de toutes les formules mathématiques présentées dans le rapport.

\begin{enumerate}
    \item \textbf{Coefficient de Corrélation de Pearson (PCC)}
    \[
    \resizebox{0.9\columnwidth}{!}{$
    sim(u, v) = \frac{\sum_{i \in I_{uv}} (r_{u,i} - \bar{r}_u) (r_{v,i} - \bar{r}_v)}{\sqrt{\sum_{i \in I_{uv}} (r_{u,i} - \bar{r}_u)^2} \sqrt{\sum_{i \in I_{uv}} (r_{v,i} - \bar{r}_v)^2}}
    $}
    \]

    \item \textbf{Similarité Cosinus}
    \[
    sim(\mathbf{x}, \mathbf{y}) = \frac{\sum x_i y_i}{\sqrt{\sum x_i^2} \sqrt{\sum y_i^2}}
    \]

    \item \textbf{Prédiction de Note (Basée Utilisateur)}
    \[
    \hat{r}_{u,i} = \bar{r}_u + \frac{\sum_{v \in N(u)} \text{sim}(u, v) \cdot (r_{v,i} - \bar{r}_v)}{\sum_{v \in N(u)} |\text{sim}(u, v)|}
    \]

    \item \textbf{Factorisation de Matrice (avec Biais)}
    \

    \item \textbf{Fonction de Coût (Erreur Quadratique Régularisée)}
    \[
    \begin{split}
    \min_{p_*, q_*, b_*} \sum_{(u,i) \in \mathcal{K}} (r_{ui} - \hat{r}_{ui})^2 \\
    + \lambda \left( \sum_u \|p_u\|^2 + \sum_i \|q_i\|^2 + \sum_u b_u^2 + \sum_i b_i^2 \right)
    \end{split}
    \]

    \item \textbf{Root Mean Squared Error (RMSE)}
    \

    \item \textbf{Mean Absolute Error (MAE)}
    \
\end{enumerate}

