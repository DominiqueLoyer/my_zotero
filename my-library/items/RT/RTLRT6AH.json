			"annotationSortIndex": "00001|001044|00258",
			"annotationText": "rien n’est joué d’avance, est un levier extrêmement puissant pour l’éducation et les apprentissages des élèves",
			"annotationType": "highlight",
			"dateAdded": "2024-12-18T21:39:00Z",
