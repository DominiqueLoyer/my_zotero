			"annotationPosition": "{\"pageIndex\":0,\"rects\":[[394.344,402.849,555.896,411.815],[339.228,392.391,524.72,401.358]]}",
			"annotationSortIndex": "00000|002901|00380",
			"annotationText": "A classifier must be represented in some formal language that the computer can handl",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T16:53:57Z",
			"dateModified": "2025-04-03T16:53:57Z",
			"itemType": "annotation",
			"key": "LSC9B9M5",
			"parentItem": "H99THKZZ",
			"relations": {},
			"tags": []
		},
		{
			"annotationAuthorName": "",
