			"annotationSortIndex": "00002|000174|00098",
			"annotationText": "Consider learning a Boolean function of (say) 100 variables from a million examples. There are 2100 − 106 examples whose classes you don’t know",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T18:39:39Z",
			"dateModified": "2025-04-03T18:39:39Z",
			"itemType": "annotation",
