		},
		{
			"annotationAuthorName": "",
			"annotationColor": "#ffd400",
			"annotationComment": "",
			"annotationPageLabel": "3",
			"annotationPosition": "{\"pageIndex\":2,\"rects\":[[444.777,256.713,555.925,265.68],[316.809,246.255,555.872,255.222],[316.809,235.798,370.548,244.764]]}",
			"annotationSortIndex": "00002|003910|00526",
			"annotationText": "Thus, contrary to intuition, a more powerful learner is not necessarily better than a less powerful one.",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T19:24:36Z",
			"dateModified": "2025-04-03T19:24:36Z",
			"itemType": "annotation",
