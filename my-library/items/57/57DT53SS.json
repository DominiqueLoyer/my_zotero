			"annotationText": "Th",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T18:53:34Z",
			"dateModified": "2025-04-03T18:53:34Z",
			"itemType": "annotation",
			"key": "NR6S47QW",
