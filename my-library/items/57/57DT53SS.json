		},
		{
			"annotationAuthorName": "",
			"annotationColor": "#ffd400",
			"annotationComment": "",
			"annotationPageLabel": "1",
			"annotationPosition": "{\"pageIndex\":0,\"rects\":[[385.057,229.662,555.921,238.629],[339.229,219.204,555.975,228.171],[339.229,208.737,353.056,217.703]]}",
			"annotationSortIndex": "00000|003637|00563",
			"annotationText": "Finally, we need a method to search among the classifiers in the language for the highest-scoring one",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T17:32:09Z",
			"dateModified": "2025-04-03T17:32:09Z",
			"itemType": "annotation",
			"key": "HAL3HFFM",
			"parentItem": "H99THKZZ",
			"relations": {},
			"tags": []
		},
		{
			"charset": "",
			"contentType": "application/pdf",
			"dateAdded": "2025-08-21T19:30:04Z",
