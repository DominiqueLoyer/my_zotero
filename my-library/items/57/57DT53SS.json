			"annotationPageLabel": "1",
			"annotationPosition": "{\"pageIndex\":0,\"rects\":[[437.402,494.037,555.894,503.004],[316.809,483.58,555.878,492.546],[316.809,473.113,392.37,482.079]]}",
			"annotationSortIndex": "00000|002609|00288",
			"annotationText": "The first problem facing you is the bewildering variety of learning algorithms available. Which one to use?",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T16:49:20Z",
			"dateModified": "2025-04-03T16:49:20Z",
			"itemType": "annotation",
			"key": "JD77Y9AM",
			"parentItem": "H99THKZZ",
			"relations": {},
			"tags": []
		},
		{
			"annotationAuthorName": "",
			"annotationColor": "#2ea8e5",
			"annotationComment": "",
			"annotationPageLabel": "3",
			"annotationPosition": "{\"pageIndex\":2,\"rects\":[[359.323,309.022,555.891,317.988],[316.809,298.564,555.918,307.53],[316.809,288.097,475.409,297.063]]}",
			"annotationSortIndex": "00002|003689|00484",
			"annotationText": "decision trees learned on different training sets generated by the same phenomenon are often very different, when in fact they should be the same",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T19:22:45Z",
			"dateModified": "2025-04-03T19:22:45Z",
			"itemType": "annotation",
			"key": "JG8W9BGK",
			"parentItem": "H99THKZZ",
