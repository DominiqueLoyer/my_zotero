			"annotationComment": "",
			"annotationPageLabel": "1",
			"annotationPosition": "{\"pageIndex\":0,\"rects\":[[417.878,114.291,555.891,123.257],[316.809,103.833,500.073,112.799]]}",
			"annotationSortIndex": "00000|004057|00668",
			"annotationText": "k most similar training examples and predicting the majority class among them",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T18:16:19Z",
			"dateModified": "2025-04-03T18:16:19Z",
