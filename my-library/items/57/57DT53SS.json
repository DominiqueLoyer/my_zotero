			"annotationComment": "",
			"annotationPageLabel": "1",
			"annotationPosition": "{\"pageIndex\":0,\"rects\":[[134.331,552.15,243.952,561.116]]}",
			"annotationSortIndex": "00000|000241|00230",
			"annotationText": "generalizing from examples",
			"annotationType": "highlight",
