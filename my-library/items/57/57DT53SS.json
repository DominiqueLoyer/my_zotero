		},
		{
			"annotationAuthorName": "",
			"annotationColor": "#2ea8e5",
			"annotationComment": "",
			"annotationPageLabel": "3",
			"annotationPosition": "{\"pageIndex\":2,\"rects\":[[53.802,715.04,65.122,724.007]]}",
			"annotationSortIndex": "00002|000022|00067",
			"annotationText": "Ge",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T18:36:34Z",
			"dateModified": "2025-04-03T18:36:34Z",
			"itemType": "annotation",
			"key": "IJWNVQM5",
			"parentItem": "H99THKZZ",
			"relations": {},
			"tags": []
		},
		{
			"annotationAuthorName": "",
			"annotationColor": "#e56eee",
			"annotationComment": "",
			"annotationPageLabel": "2",
			"annotationPosition": "{\"pageIndex\":1,\"rects\":[[461.21,347.076,555.905,356.042],[316.809,336.609,555.907,345.575],[316.809,326.151,473.623,335.117]]}",
			"annotationSortIndex": "00001|002997|00446",
			"annotationText": "Of course, holding out data reduces the amount available for training. This can be mitigated by doing cross-validation",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T18:29:01Z",
			"dateModified": "2025-04-03T18:29:01Z",
			"itemType": "annotation",
			"key": "ITE5VB5P",
			"parentItem": "H99THKZZ",
			"relations": {},
			"tags": []
		},
		{
			"annotationAuthorName": "",
			"annotationColor": "#5fb236",
			"annotationComment": "",
			"annotationPageLabel": "2",
			"annotationPosition": "{\"pageIndex\":1,\"rects\":[[316.809,388.916,555.909,397.883],[316.809,378.449,395.822,387.416]]}",
			"annotationSortIndex": "00001|002755|00394",
			"annotationText": "Contamination of your classifier by test data can occur in insidious ways, e.g.,",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T18:29:25Z",
			"dateModified": "2025-04-03T18:29:25Z",
			"itemType": "annotation",
			"key": "IXH2TI5V",
			"parentItem": "H99THKZZ",
			"relations": {},
			"tags": []
		},
		{
			"annotationAuthorName": "",
			"annotationColor": "#e56eee",
			"annotationComment": "",
			"annotationPageLabel": "4",
			"annotationPosition": "{\"pageIndex\":3,\"rects\":[[53.802,166.599,292.904,175.565],[53.802,156.132,177.002,165.099]]}",
			"annotationSortIndex": "00003|002348|00616",
			"annotationText": "After overfitting, the biggest problem in machine learning is the curse of dimensionality.",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T19:35:04Z",
			"dateModified": "2025-04-03T19:35:04Z",
			"itemType": "annotation",
			"key": "J9U6BX8Y",
