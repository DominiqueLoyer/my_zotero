			"annotationSortIndex": "00000|004008|00658",
			"annotationText": "k-nearest neighbor classifies",
			"annotationType": "highlight",
			"dateAdded": "2025-04-03T18:15:09Z",
			"dateModified": "2025-04-03T18:15:09Z",
